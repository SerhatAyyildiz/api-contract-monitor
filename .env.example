# ÖRNEK SIR DOSYASI
#
# Bu dosya güvenle paylaşılabilir cunku icinde gercek deger yoktur --
# sadece hangi bilgilerin gerektigini gosterir.
#
# Kullanimi: bu dosyanin bir kopyasini ".env" adiyla olusturun ve
# esittir isaretinin sagini gercek degerlerle doldurun.
# ".env" dosyasi .gitignore icinde oldugu icin GitHub'a gitmez.

# --- Telegram bildirimi (Hafta 3'te doldurulacak) ---
# BotFather'dan alinan bot anahtari
TELEGRAM_BOT_TOKEN=
# Mesajin gonderilecegi hesabin kimlik numarasi
TELEGRAM_CHAT_ID=

# --- Yapay zeka yorumlama (Hafta 4'te doldurulacak) ---
# Google AI Studio'dan alinan ucretsiz erisim anahtari
GEMINI_API_KEY=
